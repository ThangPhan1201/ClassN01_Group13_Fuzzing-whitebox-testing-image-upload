# ===========================================
# Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_USER=textbook
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=textbook_marketplace
POSTGRES_PORT=5432

# ===========================================
# Application Ports
# ===========================================
BACKEND_PORT=3000
FRONTEND_PORT=5173

# ===========================================
# Backend Environment
# ===========================================
NODE_ENV=development

# JWT Configuration
# IMPORTANT: Change this in production!
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ===========================================
# Admin Account
# ===========================================
# Default admin account created on first run
ADMIN_EMAIL=admin@sachgiare.vn
ADMIN_PASSWORD=Admin123!

# ===========================================
# Security (Encryption)
# ===========================================
# 32 character encryption key for sensitive data
# IMPORTANT: Change this in production!
ENCRYPTION_KEY=32_character_encryption_key_here

# ===========================================
# AWS S3 Configuration (Optional)
# ===========================================
# Leave empty if not using S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=

# ===========================================
# Frontend Environment
# ===========================================
VITE_API_URL=http://localhost:3000/api
VITE_APP_TITLE=SachGiaRe.vn
